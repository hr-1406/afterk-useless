{
  "manifest_version": 3,
  "name": "TAB JAIL",
  "version": "1.0.0",
  "description": "A ridiculous productivity enforcement Chrome extension that traps you when you procrastinate.",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {},
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/eye-tracking.js",
        "content/activity-tracker.js",
        "content/tab-jail-hud.js",
        "punishment/punishment-manager.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/tab-jail-hud.css",
        "punishment/tetris.html",
        "punishment/tetris.css",
        "punishment/tetris.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "tabs",
    "storage"
  ]
}
